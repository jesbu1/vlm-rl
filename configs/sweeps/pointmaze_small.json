{
  "base": "configs/pointmaze_qwen3vl4b_vllm.json",
  "group": "pointmaze-small-v1",
  "project": "vlm-rl-pointmaze",
  "train_gpu": 0,
  "vllm_gpu": 1,
  "vllm_port": 8011,
  "grid": {
    "model": [
      "Qwen/Qwen3-VL-2B-Instruct",
      "Qwen/Qwen3-VL-4B-Instruct",
      "HuggingFaceTB/SmolVLM2-2.2B-Instruct"
    ],
    "reward": [
      "success",
      "success+0.5*neg_dist",
      "pref_oracle_dist"
    ]
  },
  "overrides": {
    "steps": 30,
    "eval_every": 5,
    "wandb_entity": "tri",
    "wandb_tags": "pointmaze,medium,lora,sweep",
    "env_kwargs": {
      "maze": "medium",
      "max_turns": 15,
      "image_size": 336,
      "include_state": true
    }
  },
  "model_overrides": {
    "HuggingFaceTB/SmolVLM2-2.2B-Instruct": {
      "lora_targets": ".*text_model.*\\.(q_proj|k_proj|v_proj|o_proj|gate_proj|up_proj|down_proj)",
      "processor_kwargs": {
        "do_image_splitting": false
      }
    }
  },
  "vllm_args": {
    "HuggingFaceTB/SmolVLM2-2.2B-Instruct": [
      "--max-model-len",
      "8192",
      "--mm-processor-kwargs",
      "{\"do_image_splitting\": false}"
    ]
  }
}
