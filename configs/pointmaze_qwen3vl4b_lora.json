{
  "model": "Qwen/Qwen3-VL-4B-Instruct",
  "lora_rank": 64,
  "lora_alpha": 128,
  "lr": 2e-5,
  "env": "pointmaze",
  "env_kwargs": {"maze": "umaze", "max_turns": 10, "image_size": 336, "include_state": true},
  "reward": "success",
  "max_frames": 1,
  "groups_per_step": 8,
  "group_size": 8,
  "adv_mode": "center",
  "max_new_tokens": 256,
  "temperature": 1.0,
  "gen_batch_size": 32,
  "micro_batch_size": 2,
  "eval_every": 10,
  "eval_episodes": 32,
  "save_every": 50,
  "out_dir": "runs/pointmaze_q3vl4b_lora"
}
